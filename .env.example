# Django
DEBUG=False
DJANGO_SECRET_KEY=django-insecure-change-me-in-production
ALLOWED_HOSTS=your-domain.com localhost 127.0.0.1

# PostgreSQL
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-db-password
SQL_HOST=db
SQL_PORT=5432

# Caddy domain
DOMAIN=your-domain.com

# TU REST API Application Key
# สมัครได้ที่: https://restapi.tu.ac.th
TU_REST_API=TU_your_application_key_here

# TU Login Whitelist — ประเภทผู้ใช้ที่อนุญาตให้ login ได้
# ค่าที่เป็นไปได้: student, staff, lecturer, employee, alumni
# ถ้าปล่อยว่าง = อนุญาตทุก type
ALLOWED_TU_TYPES=student,staff,lecturer

# Initial Admin Usernames — username ที่จะได้ ADMIN role อัตโนมัติตอน login ครั้งแรก
# คั่นด้วยช่องว่างหรือ comma
INITIAL_ADMIN_USERNAMES=username1 username2

# Email (Gmail SMTP) — ใช้ App Password ไม่ใช่ password จริง
# สร้าง App Password ที่: https://myaccount.google.com/apppasswords
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password-here
ADMIN_EMAIL=your-email@gmail.com
